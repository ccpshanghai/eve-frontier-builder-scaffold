# ============================================
# SUI NETWORK
# ============================================
SUI_NETWORK=localnet

# Custom RPC URL (optional, defaults based on network)
# SUI_RPC_URL=http://127.0.0.1:9000

# ============================================
# KEYS & ADDRESSES
# ============================================
ADMIN_ADDRESS=
SPONSOR_ADDRESSES=

ADMIN_PRIVATE_KEY=
PLAYER_A_PRIVATE_KEY=
PLAYER_B_PRIVATE_KEY=

# ============================================
# PACKAGE IDS (populated after deployment)
# ============================================
WORLD_PACKAGE_ID=
BUILDER_PACKAGE_ID=
EXTENSION_CONFIG_ID=

# ============================================
# SUPPLY TERMINAL IDS
# ============================================
SUPPLY_TERMINAL_PACKAGE_ID=
SUPPLY_TERMINAL_ADMIN_CAP_ID=
SUPPLY_TERMINAL_CONFIG_ID=
STORAGE_UNIT_ITEM_ID=
CHARACTER_ITEM_ID=

# Optional overrides for pnpm seed-supply-terminal-payment
# SUPPLY_TERMINAL_PAYMENT_TYPE_ID=77800
# SUPPLY_TERMINAL_PAYMENT_QUANTITY=10
# SUPPLY_TERMINAL_PAYMENT_VOLUME=10
# SUPPLY_TERMINAL_PAYMENT_ITEM_ID=

# ============================================
# TENANT
# ============================================
TENANT=dev
